SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/securelan_dev
DATABASE_USER=securelan
DATABASE_PASSWORD=replace-with-a-local-password
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,tauri://localhost
SESSION_LIFETIME=7d
SERVER_SSL_ENABLED=false
SERVER_SSL_KEY_STORE=
SERVER_SSL_KEY_STORE_PASSWORD=
# LAN example: SERVER_HOST=0.0.0.0 is accepted only when SERVER_SSL_ENABLED=true.
# SERVER_SSL_KEY_STORE must be an absolute path readable only by the service account.
