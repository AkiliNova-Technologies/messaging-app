# Copy to infrastructure/docker/.env, replace every placeholder, and chmod 0600.
POSTGRES_DB=securelan
POSTGRES_USER=securelan
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SERVER_SSL_KEY_STORE_PASSWORD=replace-with-the-existing-pkcs12-password

# Absolute host paths. Never place the CA private key here.
SECURELAN_TLS_KEYSTORE=/etc/securelan/tls/server.p12
SECURELAN_CA_CERT=/usr/local/share/ca-certificates/securelan-org-ca.crt

# Must exactly match a DNS SAN in the mounted server certificate.
SECURELAN_TLS_HOSTNAME=securelan.office.example
SECURELAN_HTTPS_BIND_ADDRESS=0.0.0.0
SECURELAN_HTTPS_PORT=8080
SECURELAN_IMAGE_TAG=local
SECURELAN_POSTGRES_VOLUME=securelan_pgdata

CORS_ALLOWED_ORIGINS=http://tauri.localhost,tauri://localhost
SESSION_LIFETIME=7d
